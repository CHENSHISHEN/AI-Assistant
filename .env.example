# 非密钥参数。复制为 .env 后填写；.env 不进 git。
# OpenClaw 官方镜像，固定 tag，不用 latest
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.11.6
# 用户本人的 Telegram 数字 ID（不是 Bot 的 ID、不是用户名）
TELEGRAM_OWNER_ID=
# 容器内运行用户，与宿主机目录属主一致
ASSISTANT_UID=1001
ASSISTANT_GID=1001
# 控制台只绑定本机回环
OPENCLAW_CONSOLE_PORT=18789
# 模型：Coding Plan 国内端点，模型 ID 以 spike 实测为准
ZAI_MODEL=zai/glm-5.3
# zai 插件版本，与镜像版本保持一致
ZAI_PLUGIN_VERSION=2026.11.6
# 网关通知模式：dry-run 只记录将要发送的内容；确认后改成 live 才真发 Telegram
GATE_NOTIFY_MODE=dry-run
# Workbench 自身不可达是否推送（0 否 / 1 是）
GATE_NOTIFY_WORKBENCH_DOWN=0
# 应用启停开关：off（默认）时对真实 Workbench 不发任何写调用；on 后启停也仍需审批码
GATE_APP_ACTIONS=off
# 用户"当次明确要求"的回复怎么放行：approval（默认，要审批码）或 trust-flag（信任模型带的标志，不推荐）
GATE_USER_DIRECTED_REPLY=approval
